  if not locked then
   local mirrored=string.gsub(string.gsub(string.gsub(track.name,"Left","KEYNOVA_LEFT"),"Right","Left"),"KEYNOVA_LEFT","Right")
   local originals={};for _,key in ipairs(track.keys)do originals[key.frame]=key.id end
